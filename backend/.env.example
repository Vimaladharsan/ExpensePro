# Copy this file to .env and fill in the values

# Port the API runs on
PORT=5050

# MongoDB address (local MongoDB on the default port 27017, or a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker-pro

# Any long random text, used to sign login tokens. Keep it secret.
JWT_SECRET=change-this-to-a-long-random-string
